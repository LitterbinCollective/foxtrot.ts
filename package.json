{
  "name": "foxtrot",
  "version": "1.0.0",
  "description": "Discord bot made for playing media in the voice channels.",
  "main": "index.js",
  "scripts": {
    "build:ts": "tsc && tsc-alias && npm run sentry:sourcemaps",
    "build:cpp": "node-gyp clean configure build",
    "build": "npm run build:cpp && npm run build:ts",
    "migrate": "tsx src/typescript/manager/migrate.ts",
    "start": "node --openssl-legacy-provider dist/manager/",
    "prettier": "prettier --config ./.prettierrc --write **/*.ts",
    "auth:youtube": "node dist/manager/generate-youtube.js",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org litterbin --project foxtrot-dev ./dist/ && sentry-cli --url https://sentry.litterbin.dev/ sourcemaps upload --org litterbin --project foxtrot-dev ./dist/"
  },
  "author": "Litterbin Collective",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@discordjs/opus": "github:discordjs/opus",
    "@sentry/cli": "^2.43.1",
    "@sentry/node": "^9.15.0",
    "@sentry/profiling-node": "^8.55.0",
    "dayjs": "^1.11.7",
    "detritus-client": "github:detritusjs/client#0.16.4",
    "detritus-client-socket": "github:detritusjs/client-socket#0.8.4",
    "drizzle-orm": "^0.43.1",
    "google-assistant": "github:LitterbinCollective/google-assistant",
    "m3u8stream": "^0.8.6",
    "pg": "^8.15.6",
    "s-dl": "git+https://codeberg.org/b195/s-dl.git",
    "set-cookie-parser": "^2.6.0",
    "sh": "github:LitterbinCollective/sh",
    "tweetnacl": "^1.0.3",
    "type-fest": "^2.1.0",
    "url-pattern": "^1.0.3",
    "youtubei.js": "^10.5.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.87",
    "@types/pg": "^8.11.14",
    "@types/set-cookie-parser": "^2.4.10",
    "drizzle-kit": "^0.31.1",
    "node-addon-api": "^5.0.0",
    "node-gyp": "^10.0.1",
    "tsc-alias": "^1.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LitterbinCollective/foxtrot.ts.git"
  },
  "bugs": {
    "url": "https://github.com/LitterbinCollective/foxtrot.ts/issues"
  },
  "homepage": "https://foxtrot.litterbin.dev"
}
