{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "debug foxtrot",
      "program": "${workspaceFolder}/dist/manager/index.js",
      "sourceMaps": true,
      "smartStep": true,
      "internalConsoleOptions": "openOnSessionStart",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "env": {
        "NODE_ENV": "development",
        "LOG_LEVEL": "5"
      },
    },
    {
      "type": "node",
      "request": "launch",
      "name": "debug foxtrot (TS)",
      "program": "${workspaceFolder}/dist/manager/index.js",
      "preLaunchTask": "npm: build:ts",
      "sourceMaps": true,
      "smartStep": true,
      "internalConsoleOptions": "openOnSessionStart",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "env": {
        "NODE_ENV": "development",
        "LOG_LEVEL": "5"
      },
    },
    {
      "type": "node",
      "request": "launch",
      "name": "debug foxtrot (TS+CPP)",
      "program": "${workspaceFolder}/dist/manager/index.js",
      "preLaunchTask": "npm: build",
      "sourceMaps": true,
      "smartStep": true,
      "internalConsoleOptions": "openOnSessionStart",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "env": {
        "NODE_ENV": "development",
        "LOG_LEVEL": "5"
      },
    }
  ]
}